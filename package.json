{
  "name": "ralma",
  "version": "0.3.0",
  "description": "Stateless Ractive components for Bulma",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldi/ralma.git"
  },
  "files": [
    "src/",
    "bin/"
  ],
  "exports": {
    ".": "./src/index.js",
    "./browser": "./bin/ralma.js",
    "./min": "./bin/ralma.min.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "build": "node ./tools/build.mjs",
    "prepack": "npm test && npm run build && npm run format:check",
    "format:check": "node ./tools/format-check.mjs",
    "format": "node ./tools/format.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "ractive": "^1.4.4"
  }
}
