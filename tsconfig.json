{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  // Shipped code only. test/ exercises deliberately loose Ractive stubs, and docs/ carries its
  // own toolchain — including either drags both into strict checking for no benefit.
  "include": ["src/**/*.js", "tools/**/*.mjs"]
}
